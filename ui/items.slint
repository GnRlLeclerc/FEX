/// Item key u64 workaround
export struct ItemKey {
    upper: int,
    lower: int,
}

export struct Item {
    key: ItemKey,
    name: string,
    selected: bool,
    icon: image,
}

export component ItemView inherits Rectangle {
    in-out property <Item> item;
    callback select(key: ItemKey, exclusive: bool);
    callback open(key: ItemKey);

    background: ta.has-hover ? red : item.selected ? grey : transparent;

    height: 100px;
    border-radius: 15px;

    property <bool> ctrl: false;
    property <bool> shift: false;

    ta := TouchArea {

        // Use pointer event to keep track of modifiers.
        pointer-event(event) => {
            ctrl = event.modifiers.control;
            shift = event.modifiers.shift;
        }

        clicked => select(item.key, !ctrl);
        double-clicked => open(item.key);
    }

    HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            alignment: center;

            Image {
                source: item.icon;
                height: 50px;
                width: 50px;
            }
        }

        Text {
            text: item.name;
            vertical-alignment: center;
        }
    }
}
