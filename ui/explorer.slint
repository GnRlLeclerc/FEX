import { Button, ScrollView, LineEdit } from "std-widgets.slint";
import { Item, ItemKey } from "./items.slint";
import { LazyList } from "./lazylist.slint";

enum State {
    searching, // typing while in search mode
    inspecting, // inspecting search results
    browsing, // not in search mode
}

component SearchComponent {
    in-out property <State> state;
    in-out property <bool> focus-on-init: true;
    property <bool> has-focus: line.has-focus;
    callback search(text: string);

    init => {
        // https://github.com/slint-ui/slint/issues/7617
        // line.focus();
    }

    // Sync focus -> state
    changed has-focus => {
        if has-focus {
            state = State.searching;
        } else {
            state = State.inspecting;
        }
    }

    // Sync state -> focus
    changed state => {
        if state == State.searching {
            line.focus()
        } else {
            line.clear-focus()
        }
    }

    line := LineEdit {
        edited(text) => {
            search(text);
        }
    }
}

export component Explorer inherits Window {
    forward-focus: scope;

    in property <[Item]> items;
    in property <[string]> cwd: ["aaa", "bbb", "ccc"];
    in property <int> remaining: 0;
    property <State> state: browsing;

    // Properly reset focus to the root scope on search exit
    changed state => {
        if state != State.searching {
            scope.focus();
        }
    }

    callback open(key: ItemKey);
    callback navigate(count: int); // navigate to the i-th cwd component
    callback refresh-entries(offset: int, limit: int);
    callback search(text: string);

    // Reset scroll (call this after navigating)
    public function reset-scroll() {
        lazy.reset-scroll();
    }

    scope := FocusScope {
        KeyBinding {
            keys: @keys(Slash);
            activated => {
                if state != State.searching {
                    state = State.searching;
                }
            };
        }

        KeyBinding {
            keys: @keys(Escape);
            activated => {
                if state == State.searching {
                    state = State.inspecting;
                } else if state == State.inspecting {
                    state = State.browsing;
                }
            }
        }

        VerticalLayout {
            if state == State.browsing: ScrollView {
                height: 50px;
                HorizontalLayout {
                    for item[index] in cwd: Button {
                        text: item;
                        clicked => navigate(index);
                    }
                }
            }

            if state != State.browsing: SearchComponent {
                search(text) => {
                    search(text);
                    reset-scroll();
                }
                state <=> root.state;
            }

            lazy := LazyList {
                items: items;
                remaining: remaining;
                refresh-entries(offset, limit) => refresh-entries(offset, limit);
                open(key) => open(key);
            }
        }
    }
}
