import { Button, ScrollView, LineEdit } from "std-widgets.slint";
import { Item } from "./items.slint";
import { ItemKey } from "./utils.slint";
import { LazyList } from "./lazylist.slint";
import { Search, SearchState } from "./search.slint";
import { Callbacks } from "./callbacks.slint";


// Re-export global singletons to make them accessible from rust
export { Callbacks } from "./callbacks.slint";

export component Explorer inherits Window {
    forward-focus: scope;

    in property <[Item]> items;
    in property <[string]> cwd;
    in property <int> remaining: 0;
    property <SearchState> state: browsing;

    // Properly reset focus to the root scope on search exit
    changed state => {
        if state != SearchState.searching {
            scope.focus();
        }
    }

    public function reset-scroll() {
        lazy.reset-scroll();
    }

    scope := FocusScope {
        KeyBinding {
            keys: @keys(Slash);
            activated => {
                if state != SearchState.searching {
                    state = SearchState.searching;
                }
            };
        }

        KeyBinding {
            keys: @keys(Escape);
            activated => {
                if state == SearchState.searching {
                    state = SearchState.inspecting;
                } else if state == SearchState.inspecting {
                    state = SearchState.browsing;
                    Callbacks.search("");
                } else if state == SearchState.browsing {
                    Callbacks.select-all(false);
                }
            }
        }

        KeyBinding {
            keys: @keys(Control + A);
            activated => {
                Callbacks.select-all(true);
            }
        }

        VerticalLayout {
            if state == SearchState.browsing: ScrollView {
                height: 50px;
                HorizontalLayout {
                    for item[index] in cwd: Button {
                        text: item;
                        clicked => {
                            Callbacks.navigate(index);
                            state = SearchState.browsing;
                            Callbacks.search("");
                            lazy.reset-scroll();
                        };
                    }
                }
            }

            if state != SearchState.browsing: Search {
                search(text) => {
                    Callbacks.search(text);
                    reset-scroll();
                }
                state <=> root.state;
            }

            lazy := LazyList {
                items: items;
                remaining: remaining;
            }
        }
    }
}
