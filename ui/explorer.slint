import { Button, ScrollView } from "std-widgets.slint";
component Entry inherits Rectangle {
    in property <string> name;

    background: ta.has-hover ? red : transparent;

    height: 100px;
    border-radius: 15px;

    ta := TouchArea { }

    // For now, display as lines, easier to attempt the lazy scroll this way
    HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            alignment: center;

            Rectangle {
                background: blue;

                height: 50px;
                width: 50px;
            }
        }

        Text {
            text: name;
            vertical-alignment: center;
        }
    }
}

export component Explorer inherits Window {
    in-out property <int> per-col: 5;
    in property <[string]> names; // Only the displayed names

    // Is set when selecting a rectangle of items
    out property <{x: length, y: length}> select;
    out property <bool> selecting: false;

    out property <int> offset: Math.floor(-scroll.viewport-y / 110px); // entries hidden by the current scroll offset
    out property <int> limit: Math.ceil(scroll.visible-height / 110px); // amount of visible entries
    in property <int> remaining: 0; // remaining entries to be padded with placeholders for accurate scrollbar size

    changed offset => refresh-slice(offset, limit);
    changed limit => refresh-slice(offset, limit);
    callback refresh-slice(offset: int, limit: int);

    scroll := ScrollView {
        ta := TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    selecting = true;
                    select = { x: ta.mouse-x, y: ta.mouse-y };
                }
                if event.kind == PointerEventKind.up {
                    selecting = false;
                }
            }
        }

        VerticalLayout {
            spacing: 10px;

            // Virtual padding for elements scrolled out of view
            Rectangle {
                height: offset * 110px;
            }

            for name[index] in names: Entry {
                name: name;
            }

            // Virtual padding for remaining elements not yet scrolled into view
            Rectangle {
                height: remaining * 110px;
            }
        }

        // Selection rectangle
        Rectangle {
            visible: selecting;

            border-color: green;
            border-width: 2px;
            border-radius: 5px;

            x: Math.min(select.x, ta.mouse-x);
            y: Math.min(select.y, ta.mouse-y);

            width: Math.abs(ta.mouse-x - select.x);
            height: Math.abs(ta.mouse-y - select.y);
        }
    }
}
