import { Item, Items, ItemView } from "./items.slint";
import { Range, Utils } from "./utils.slint";
import { ScrollView } from "std-widgets.slint";
import { Config } from "config.slint";
import { Callbacks } from "./callbacks.slint";
import { Mouse } from "mouse.slint";


export component LazyList {
    in property <Items> items;
    property <int> cursor: -1;

    public function enter() {
        if cursor != -1 {
            let item = items.items[cursor - offset];
            Callbacks.open(item.key);
        }
    }

    // Set the cursor to the topmost visible element,
    // and fully scroll it into view.
    public function set-cursor() {
        cursor = offset;
        scroll.viewport-y = -cursor * Config.item-total-height;
    }

    public function up(select: bool) {
        if cursor == -1 {
            set-cursor();
        } else if cursor > 0 {
            cursor -= 1;
            let delta = -cursor * Config.item-total-height - scroll.viewport-y;
            if delta > 0 {
                scroll.viewport-y = -cursor * Config.item-total-height;
            }
        }
    }

    public function down(select: bool) {
        if cursor == -1 {
            set-cursor();
        } else if cursor < items.offset + items.items.length + items.remaining - 1 {
            cursor += 1;
            let delta = -cursor * Config.item-total-height - scroll.viewport-y + scroll.visible-height - Config.item-total-height;
            if delta < 0 {
                scroll.viewport-y = -cursor * Config.item-total-height + scroll.visible-height - Config.item-total-height;
            }
        }
    }

    property <int> offset: Math.floor(-scroll.viewport-y / Config.item-total-height); // entries hidden by the current scroll offset
    property <int> limit: Math.ceil(scroll.visible-height / Config.item-total-height) + 1; // amount of visible entries
    property <length> list-padding-top;

    // Refresh both entries and top padding rectangle at the same time
    // in order to avoid flickering when scrolling at high speed
    function refresh() {
        Callbacks.refresh-entries(offset, limit);
        list-padding-top = offset * Config.item-total-height;
    }

    changed offset => refresh();
    changed limit => refresh();

    // Reset scroll (call this after navigating)
    public function reset-scroll() {
        scroll.viewport-y = 0;
    }

    // Scroll on select when the cursor is near the top / bottom
    timer := Timer {
        interval: Config.scroll-tick;
        running: Mouse.selecting || Mouse.dragging;
        triggered() => {
            scroll.viewport-y = Mouse.tick-scroll(scroll.y, scroll.viewport-y, scroll.visible-height, scroll.viewport-height);
        }
    }

    scroll := ScrollView {
        animate viewport-y { duration: 50ms; }

        scrolled => {
            cursor = -1;
        }

        ta := TouchArea {
            pointer-event(event) => Mouse.pointer-event(event, ta.mouse-x, ta.mouse-y, false);
        }

        VerticalLayout {
            spacing: Config.spacing;

            // Virtual padding for elements scrolled out of view
            Rectangle {
                height: items.offset * Config.item-total-height;
            }

            for item[index] in items.items: ItemView {
                list-y: (offset + index) * Config.item-total-height + Config.spacing;
                item: item;
                has-cursor: index + offset == cursor;
            }

            // Virtual padding for remaining elements not yet scrolled into view
            Rectangle {
                height: items.remaining * Config.item-total-height;
            }
        }

        // Item dragging indicator
        Image {
            visible: Mouse.dragging;
            x: Mouse.mouse.x;
            y: Mouse.mouse.y;

            source: Mouse.dragged;
            height: 50px;
            width: 50px;
        }

        // Selection rectangle
        Rectangle {
            visible: Mouse.selecting;

            border-color: green;
            border-width: 2px;
            border-radius: 5px;

            x: Mouse.select-x();
            y: Mouse.select-y();

            width: Mouse.select-width();
            height: Mouse.select-height();
        }
    }
}
